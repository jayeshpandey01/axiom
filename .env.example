APP_ENV=development
DATABASE_URL=sqlite:///./scan_tool.db
# Development only. Production must set AUTH_MODE=oidc and the OIDC values below.
AUTH_MODE=api_key
API_KEY=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-separate-long-random-secret
OIDC_ISSUER=https://issuer.example.com/
OIDC_AUDIENCE=scan-tool-api
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
OIDC_ROLE_CLAIM=roles
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RESULT_STORAGE_BUCKET=scan-tool-results
RESULT_STORAGE_REGION=ap-south-1
# Optional for an S3-compatible provider such as Cloudflare R2 or MinIO.
RESULT_STORAGE_ENDPOINT_URL=
RESULT_STORAGE_KMS_KEY_ID=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESULT_ENCRYPTION_KEY=
RESULT_RETENTION_DAYS=30
CONTROLLER_SHARED_SECRET=replace-with-a-different-long-random-secret
MAX_TARGETS_PER_SCAN=10
LOG_LEVEL=INFO
